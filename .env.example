# Kopiér denne fil til ".env" og udfyld værdierne.
# .env må ALDRIG lægges offentligt (fx på GitHub) – den indeholder jeres hemmelige nøgle.

# API-nøgle fra https://console.anthropic.com  (Settings → API Keys)
ANTHROPIC_API_KEY=

# Hvilken Claude-model chatbotten bruger.
# claude-haiku-5-5  = hurtig og billig (anbefalet til en hjemmeside-chat)
# claude-sonnet-5-5 = grundigere svar, dyrere
CLAUDE_MODEL=claude-haiku-5-5

# Maks. længde på et svar (tokens)
CLAUDE_MAX_TOKENS=1024

# Maks. antal chat-beskeder pr. besøgende pr. 10 minutter
CHAT_RATE_LIMIT=30

# Port serveren kører på
PORT=3000
